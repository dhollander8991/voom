{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    // This is an application, not a library — nothing consumes the emitted
    // .d.ts, so skip declaration emit (it also lets internal-only types stay
    // unexported). Source maps stay on for readable stack traces.
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests"]
}
