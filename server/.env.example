# Get a free key at https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Optional: Anthropic API key for the author-summary feature. When unset, the
# app runs normally and the author endpoint just returns no info.
# Create one at https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# HTTP port the API listens on
PORT=3001

# How often the poller refreshes news from NewsAPI (minutes).
# 15 min => ~96 calls/day, still under the free tier's 100/day cap.
POLL_INTERVAL_MINUTES=15

# SQLite database file location (relative to the server workspace)
DATABASE_PATH=./data/news.db
